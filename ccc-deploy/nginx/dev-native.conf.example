# nginx front for a NATIVE (no Docker) CCC — development, demos and small pilots.
# See docs/RUNNING_THE_SERVER.md. Replace the two placeholders, then include this file from nginx.conf
# (inside the `http { }` block):
#   @CA_DIR@   folder created by `php artisan xephyguard:ca:init`
#              Linux:   /home/you/xephyguard/server/storage/app/private/ca
#              Windows: C:/xephyguard/server/storage/app/private/ca      (forward slashes!)
#   @PUBLIC@   the Laravel public folder, e.g. C:/xephyguard/server/public
#
# Behind it run:  php artisan serve --host=127.0.0.1 --port=8000      (Laravel)
#                 php artisan reverb:start --host=127.0.0.1 --port=8081 (WebSockets)
# Ports on the lab network: 80 (CA + installers), 443 (dashboard), 8443 (agents, mTLS).

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream xg_laravel { server 127.0.0.1:8000; }
upstream xg_reverb  { server 127.0.0.1:8080; }
upstream xg_gateway { server 127.0.0.1:8082; }

server {
    listen 80;
    root @PUBLIC@;
    location = /ca.crt     { proxy_pass http://xg_laravel; proxy_set_header Host $host; }
    location ^~ /install/  { proxy_pass http://xg_laravel; proxy_set_header Host $host; }
    location ^~ /downloads/{ proxy_pass http://xg_laravel; proxy_set_header Host $host; }
    location = /notice     { proxy_pass http://xg_laravel; proxy_set_header Host $host; }
    location ^~ /build/    { try_files $uri =404; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    ssl_certificate     @CA_DIR@/server.crt;
    ssl_certificate_key @CA_DIR@/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root @PUBLIC@;

    location ^~ /api/screen/ {
        proxy_pass http://xg_laravel;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-SSL-Client-Verify "";
        proxy_set_header X-SSL-Client-Cert "";
    }
    location ^~ /api/   { return 404; }
    location ^~ /build/ { try_files $uri =404; }
    location ^~ /app/ {                       # Reverb for dashboard browsers (live updates)
        proxy_pass http://xg_reverb;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
    }
    location ^~ /screen-gw/ {                 # Screen viewer & agent WebSocket relay
        proxy_pass http://xg_gateway/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
    location / {
        proxy_pass http://xg_laravel;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-SSL-Client-Verify "";   # never accept these from the dashboard side
        proxy_set_header X-SSL-Client-Cert "";
    }
}

server {
    listen 8443 ssl;
    ssl_certificate        @CA_DIR@/server.crt;
    ssl_certificate_key    @CA_DIR@/server.key;
    ssl_protocols          TLSv1.3;
    ssl_client_certificate @CA_DIR@/ca.crt;
    ssl_verify_client      optional;          # enrollment happens before the agent has a certificate
    ssl_verify_depth       1;

    location ^~ /api/agent/v1/enroll {
        proxy_pass http://xg_laravel;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-Cert $ssl_client_escaped_cert;
    }
    location ^~ /api/agent/v1/ {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        proxy_pass http://xg_laravel;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-Cert $ssl_client_escaped_cert;
    }
    location ^~ /app/ {                       # Reverb channel for agent commands (mTLS required)
        if ($ssl_client_verify != SUCCESS) { return 403; }
        proxy_pass http://xg_reverb;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
    }
    location / { return 404; }
}
