# Debian package (primary) and optional RPM for the Linux agent.
if(WIN32)
  return()
endif()
set(XG_ROOT ${CMAKE_CURRENT_SOURCE_DIR}/..)
set(CMAKE_INSTALL_DEFAULT_DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
find_package(Python3 COMPONENTS Interpreter)
set(XG_SIGS ${CMAKE_CURRENT_BINARY_DIR}/signatures.json)
add_custom_command(OUTPUT ${XG_SIGS}
  COMMAND ${Python3_EXECUTABLE} ${XG_ROOT}/scripts/compile_signatures.py --out ${XG_SIGS}
  DEPENDS ${XG_ROOT}/scripts/compile_signatures.py
  COMMENT "Compiling seed signature bundle")
add_custom_target(seed_signatures ALL DEPENDS ${XG_SIGS})

install(TARGETS xephyguard-agent xephyguard-helper RUNTIME DESTINATION lib/xephyguard)
install(PROGRAMS ${XG_ROOT}/installers/linux/install-browser-ca.sh DESTINATION lib/xephyguard)
install(FILES ${XG_ROOT}/installers/linux/xephyguard-agent.service DESTINATION lib/systemd/system)
install(FILES ${XG_ROOT}/installers/linux/xephyguard-helper.service DESTINATION lib/systemd/user)
install(FILES ${XG_ROOT}/installers/linux/xephyguard-helper.desktop DESTINATION /etc/xdg/autostart)
install(FILES ${XG_SIGS} ${XG_ROOT}/installers/linux/issue.net DESTINATION share/xephyguard)
install(FILES ${XG_ROOT}/installers/linux/agent.toml.default DESTINATION share/xephyguard)
install(DIRECTORY ${XG_ROOT}/installers/browser-policies/ DESTINATION share/xephyguard/browser-policies)
set(CPACK_PACKAGE_NAME xephyguard-agent)
set(CPACK_PACKAGE_VENDOR "XephyGuard")
set(CPACK_PACKAGE_CONTACT "lab-admin@example.edu")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "XephyGuard lab AI-use monitoring agent")
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
set(CPACK_GENERATOR "DEB")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "ca-certificates, libnotify-bin")
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "libnss3-tools")
set(CPACK_DEBIAN_PACKAGE_SECTION admin)
set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA ${XG_ROOT}/installers/linux/postinst ${XG_ROOT}/installers/linux/prerm ${XG_ROOT}/installers/linux/postrm)
set(CPACK_DEBIAN_PACKAGE_CONTROL_STRICT_PERMISSION ON)
set(CPACK_RPM_PACKAGE_REQUIRES "ca-certificates, libnotify")
set(CPACK_RPM_POST_INSTALL_SCRIPT_FILE ${XG_ROOT}/installers/linux/postinst)
set(CPACK_RPM_PRE_UNINSTALL_SCRIPT_FILE ${XG_ROOT}/installers/linux/prerm)
include(CPack)
