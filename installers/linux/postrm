#!/bin/sh
set -e
[ "$1" = remove ] || [ "$1" = purge ] && {
  rm -f /usr/sbin/xephyguard-agent /etc/systemd/resolved.conf.d/xephyguard.conf
  systemctl try-reload-or-restart systemd-resolved >/dev/null 2>&1 || true
  # Network rules the agent installed (isolation, session network lock) must not outlive it.
  for t in xephyguard_isolate xephyguard_lock; do nft delete table inet "$t" >/dev/null 2>&1 || true; done
}
if [ "$1" = purge ]; then
  rm -rf /etc/xephyguard /var/lib/xephyguard /var/log/xephyguard
  rm -f /usr/local/share/ca-certificates/xephyguard-lab-ca.crt /etc/opt/chrome/policies/managed/xephyguard.json \
        /etc/chromium/policies/managed/xephyguard.json /etc/opt/edge/policies/managed/xephyguard.json /etc/issue.d/xephyguard.issue
  update-ca-certificates --fresh >/dev/null 2>&1 || true
fi
exit 0
